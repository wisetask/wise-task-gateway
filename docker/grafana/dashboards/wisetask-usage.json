          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sort_desc(sum by (operation) (increase(graphql_requests_total{application=\"wise-task-gateway\"}[$__range])))",
          "legendFormat": "{{operation}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "always",
        "stacking": "normal",
        "legend": {
          "showLegend": false
        },
        "xTickLabelRotation": 0,
        "xField": "Operation"
      },
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "labelsToFields": false
          }
        }
      ]
    },
